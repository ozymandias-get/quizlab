{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "devtools",
    "elec",
    "electronjs",
    "eslint",
    "loglevel",
    "oklch",
    "openai",
    "pdfjs",
    "pdfs",
    "playwright",
    "prefs",
    "quizlab",
    "revalidate",
    "scrollbar",
    "subdir",
    "tanstack",
    "tsup",
    "unsub",
    "vaapi",
    "vite",
    "vitest",
    "webp"
  ],
  "flagWords": [],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "release/**",
    ".git/**",
    "*.json",
    "*.lock",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.woff",
    "*.woff2",
    "pnpm-lock.yaml",
    "src/shared/i18n/locales/**",
    "**/__tests__/**"
  ],
  "allowCompoundWords": true,
  "dictionaries": ["en_US", "softwareTerms", "node", "typescript", "css", "html"]
}

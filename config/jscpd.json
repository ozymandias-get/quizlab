{
  "threshold": 0,
  "minLines": 5,
  "minTokens": 50,
  "reporters": ["html", "console"],
  "output": "reports/duplicates/jscpd",
  "format": ["typescript", "javascript", "tsx", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/release/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts"
  ],
  "silent": false,
  "skipLocal": true
}

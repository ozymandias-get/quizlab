{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "src/index.html",
    "src/shared/styles/index.css",
    "electron/preload/index.ts",
    "electron/preload/displayMediaPickerPreload.ts",
    "scripts/{dev,build-electron,check-repo-hygiene,check-version-consistency}.mjs",
    "scripts/{check-audit,check-declaration-consistency,check-electron-security}.d.mts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "electron/**/*.{ts,tsx}",
    "shared/**/*.ts",
    "scripts/**/*.{mjs,mts}"
  ],
  "ignoreDependencies": ["@doyensec/electronegativity"],
  "ignoreBinaries": ["taskkill"]
}

# Quizlab Reader — environment variables
#
# IMPORTANT: the Electron main process reads `process.env` directly. There is
# no `.env` loader in this project, so renaming this file to `.env` has no
# effect. Export the variables in the shell that launches the app instead:
#
#   bash/zsh:  export APP_OPEN_DEVTOOLS=1 && npm run dev
#   PowerShell: $env:APP_OPEN_DEVTOOLS = '1'; npm run dev
#
# All values below are optional; the defaults shown are what the code uses.
# DO NOT commit real secrets or credentials to the repository.

# ==========================================
# 1. Window & Application
# ==========================================

# Dev-server URL the main window loads.
# Default: http://localhost:5173
APP_RENDERER_URL=http://localhost:5173

# Open Chrome DevTools on startup (1 = enabled).
# Default: 0
APP_OPEN_DEVTOOLS=0

# Suffix for the user-data directory. "stable" (the default in a packaged
# build) means <appData>/Quizlab Reader. Any other value is also used to decide
# the single-instance lock: the lock is only taken for the "stable" profile, so
# a named profile lets you run a second copy side by side.
# Default: stable (dev builds use "dev" -> <appData>/Quizlab Reader Dev)
# QUIZLAB_PROFILE=stable

# Absolute path override for the user-data directory. Takes precedence over
# QUIZLAB_PROFILE.
# QUIZLAB_USER_DATA_DIR=

# Disable hardware acceleration (1 = enabled). Useful on VMs and remote
# desktops where the GPU process is unstable.
# Default: 0
# QUIZLAB_DISABLE_GPU=0


# ==========================================
# 2. Google AI Web Session
# ==========================================

# NOTE: there is no on/off feature flag — the Google AI web session is always
# compiled in and can be managed from Settings.

# Whether the session is enabled for a new user by default (true/false).
# Default: true. Set to false to opt users in explicitly.
GEMINI_WEB_SESSION_DEFAULT_ENABLED=true

# Timeout for the initial Google sign-in flow, in milliseconds.
# 0 disables the timeout. Otherwise clamped to 300,000 (5 min) - 43,200,000 (12 h).
# Default: 7200000 (2 hours)
GEMINI_WEB_LOGIN_TIMEOUT_MS=7200000

# Interval between Google login / cookie-freshness health checks, in
# milliseconds. Clamped to 60,000 - 3,600,000.
# Default: 300000 (5 minutes)
GEMINI_WEB_CHECK_INTERVAL_MS=300000

# Random jitter percentage added to the check interval so sessions do not all
# poll at the same moment. Range 0 - 50.
# Default: 10
GEMINI_WEB_CHECK_JITTER_PCT=10

# Delay before retrying after a failed health check, in milliseconds.
# Clamped to 10,000 - 600,000.
# Default: 30000 (30 seconds)
GEMINI_WEB_RETRY_DELAY_MS=30000

# Consecutive failures tolerated before the session is marked degraded or needs
# re-authentication. Range 1 - 5.
# Default: 2
GEMINI_WEB_MAX_CONSECUTIVE_FAILURES=2


# ==========================================
# 3. Silent & proactive session refresh
# ==========================================

# Cookie age that triggers a silent background refresh, in milliseconds.
# Clamped to 60,000 - 3,600,000.
# Default: 300000 (5 minutes)
GEMINI_WEB_COOKIE_REFRESH_THRESHOLD_MS=300000

# How long before expiry a proactive refresh is attempted, in milliseconds.
# Clamped to 60,000 - 1,800,000.
# Default: 600000 (10 minutes)
GEMINI_WEB_PROACTIVE_REFRESH_ADVANCE_MS=600000

# Grace period after a known refresh trigger before health state is
# re-evaluated, in milliseconds. Clamped to 1,000 - 30,000.
# Default: 5000
GEMINI_WEB_REFRESH_GRACE_PERIOD_MS=5000

# Cooldown between two silent refreshes, in milliseconds.
# Clamped to 60,000 - 3,600,000.
# Default: 600000 (10 minutes)
GEMINI_WEB_SILENT_REFRESH_COOLDOWN_MS=600000


# ==========================================
# 4. Chrome Extension Bridge
# ==========================================

# Port for the loopback HTTP bridge the Chrome extension talks to. If the port
# is taken the app increments it and retries (up to 51999-52009).
# Must be 1025 - 65534.
# Default: 51999
QUIZLAB_EXTENSION_BRIDGE_PORT=51999


# ==========================================
# 5. PDF viewer (renderer build only)
# ==========================================

# NOTE: this one is read by the renderer through `import.meta.env`, so Vite's
# own `.env` loading applies here — a `.env` file works for this variable even
# though the note at the top of this file says otherwise for main-process
# variables. Exporting it in the shell works for both.

# Replace the shipped `@react-pdf-viewer` PDF viewer with the native
# pdfjs-dist 6 canvas viewer.
# Only the exact value `true` enables it. Unset, `false`, `0`, `yes` and `TRUE `
# all leave the legacy viewer in place, so a stray value cannot silently swap
# the shipped renderer.
# Default: legacy viewer (the native path is an in-progress migration and does
# not yet support search, text selection, page-text extraction or capture).
# VITE_NATIVE_PDF_VIEWER=true

{
  "manifest_version": 3,
  "name": "Quizlab Site Session Bridge",
  "version": "1.0.0",
  "description": "Shares the session cookies of the AI sites you use with Quizlab Reader for workspace access.",
  "permissions": ["cookies", "alarms", "storage", "webNavigation"],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://*.youtube.com/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://*.claude.ai/*",
    "https://*.anthropic.com/*",
    "https://*.deepseek.com/*",
    "https://*.qwenlm.ai/*",
    "https://*.qwen.ai/*",
    "https://*.kimi.com/*",
    "https://*.moonshot.cn/*",
    "https://*.microsoft.com/*",
    "https://*.microsoftonline.com/*",
    "https://*.live.com/*",
    "https://*.cloud.microsoft/*",
    "https://*.grok.com/*",
    "https://*.x.com/*",
    "https://*.mistral.ai/*",
    "https://*.perplexity.ai/*",
    "https://*.huggingface.co/*",
    "https://*.manus.im/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quizlab Site Sessions"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}

{
  "name": "quizlab-reader",
  "version": "7.5.2",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "description": "AI-powered PDF reader with a split-screen workspace: read documents alongside ChatGPT, Gemini, Claude, and more via managed WebContentsView panels, automation, and local-first privacy.",
  "main": "dist/electron/electron/app/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozymandias-get/quizlab.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:electron": "npm run build:backend && wait-on http://localhost:5173 && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:check-hygiene": "node scripts/check-repo-hygiene.mjs",
    "ci:check-version": "node scripts/check-version-consistency.mjs",
    "ci:check-declarations": "node scripts/check-declaration-consistency.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:audit": "node scripts/check-audit.mjs",
    "check:electron-security": "node scripts/check-electron-security.mjs",
    "analyze:bundle": "vite-bundle-visualizer",
    "analyze:knip": "knip",
    "analyze:deadcode": "npm run analyze:knip",
    "analyze:duplicates": "jscpd --config config/jscpd.json src electron shared --reporters console",
    "analyze:circular": "madge --circular --extensions ts,tsx,js,jsx src/ electron/ shared/",
    "analyze:architecture": "depcruise --config config/dependency-cruiser.cjs --validate --output-type err --do-not-follow node_modules src electron shared",
    "analyze:security": "npm run analyze:semgrep && npm run check:audit && npm run check:electron-security",
    "analyze:semgrep": "node scripts/check-semgrep.mjs",
    "analyze:types": "type-coverage --strict --project config/tsconfig.app.json --detail --ignore-files \"**/*.test.*\" --ignore-files \"**/*.spec.*\" --ignore-files \"**/__tests__/**\"",
    "analyze:types:ci": "node scripts/check-type-coverage.mjs",
    "analyze:mutation": "stryker run config/stryker.config.mjs",
    "analyze:css": "stylelint \"src/**/*.css\"",
    "analyze:spell:ci": "cspell --no-progress --show-context --no-exit-code \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "analyze:file-sizes": "node scripts/check-file-sizes.mjs",
    "analyze:all": "npm run analyze:deadcode && npm run analyze:duplicates && npm run analyze:circular && npm run analyze:architecture && npm run analyze:security && npm run analyze:types",
    "build:backend": "tsc -b config/tsconfig.node.json --force && esbuild electron/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/electron/electron/preload/index.js --external:electron",
    "build:renderer:web": "vite build",
    "build:renderer:electron": "node scripts/build-electron.mjs",
    "build:web": "tsc -b && npm run build:renderer:web",
    "build": "tsc -b && npm run build:renderer:electron && npm run build:backend",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.quizlab.reader",
    "productName": "Quizlab Reader",
    "copyright": "Copyright (c) 2026 Quizlab Reader",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "QuizLab-Setup-${version}-x64.${ext}",
      "executableName": "Quizlab Reader",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "packElevateHelper": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quizlab Reader",
      "include": "installer/installer.nsh",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "language": "1033",
      "warningsAsErrors": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "ozymandias-get@users.noreply.github.com"
    },
    "publish": {
      "provider": "github",
      "owner": "ozymandias-get",
      "repo": "quizlab",
      "releaseType": "release"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "electronLanguages": [
      "en-US",
      "tr"
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "keywords": [
    "electron",
    "react",
    "pdf-viewer",
    "ai-assistant",
    "study-tool",
    "gemini-ai",
    "education",
    "exam-prep",
    "active-recall",
    "pdf-annotation",
    "typescript",
    "vite"
  ],
  "author": "ozymandias-get",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@doyensec/electronegativity": "^1.10.3",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^18.7.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.4",
    "type-coverage": "^2.31.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.5.0"
    },
    "eslint-plugin-react": {
      "eslint": "^10.5.0"
    },
    "tar": ">=7.5.21",
    "typed-rest-client": {
      "qs": ">=6.16.1"
    }
  },
  "lint-staged": {
    "!(package-lock).{ts,tsx,js,jsx,json,md,css}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "apply",
            "layer",
            "config",
            "theme",
            "custom-variant",
            "utility",
            "variant",
            "source",
            "reference"
          ]
        }
      ],
      "at-rule-prelude-no-invalid": [
        true,
        {
          "ignoreAtRules": [
            "apply"
          ]
        }
      ],
      "alpha-value-notation": null,
      "lightness-notation": null,
      "color-function-notation": null,
      "color-function-alias-notation": null,
      "custom-property-empty-line-before": null,
      "font-family-no-missing-generic-family-keyword": null,
      "no-duplicate-selectors": null,
      "selector-class-pattern": null,
      "keyframes-name-pattern": null,
      "property-no-vendor-prefix": null,
      "selector-no-vendor-prefix": null,
      "value-keyword-case": null,
      "comment-empty-line-before": null,
      "declaration-empty-line-before": null,
      "declaration-property-value-keyword-no-deprecated": null,
      "selector-type-no-unknown": true,
      "custom-property-pattern": null,
      "media-feature-range-notation": null,
      "hue-degree-notation": "number",
      "no-descending-specificity": null,
      "declaration-block-no-redundant-longhand-properties": true,
      "rule-empty-line-before": [
        "always-multi-line",
        {
          "except": [
            "first-nested"
          ],
          "ignore": [
            "inside-block"
          ]
        }
      ],
      "at-rule-empty-line-before": [
        "always",
        {
          "except": [
            "first-nested",
            "blockless-after-same-name-blockless"
          ],
          "ignore": [
            "after-comment"
          ],
          "ignoreAtRules": [
            "utility"
          ]
        }
      ],
      "color-hex-length": "long",
      "import-notation": "string"
    },
    "ignoreFiles": [
      "dist/**",
      "node_modules/**",
      "coverage/**",
      "release/**",
      ".cache/**"
    ]
  },
  "cspell": {
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en",
    "words": [
      "devtools",
      "elec",
      "electronjs",
      "eslint",
      "loglevel",
      "oklch",
      "openai",
      "pdfjs",
      "pdfs",
      "playwright",
      "prefs",
      "quizlab",
      "revalidate",
      "scrollbar",
      "subdir",
      "tanstack",
      "tsup",
      "unsub",
      "vaapi",
      "vite",
      "vitest",
      "webp"
    ],
    "flagWords": [],
    "ignorePaths": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "release/**",
      ".git/**",
      "*.json",
      "*.lock",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.woff",
      "*.woff2",
      "pnpm-lock.yaml",
      "src/shared/i18n/locales/**",
      "**/__tests__/**"
    ],
    "allowCompoundWords": true,
    "dictionaries": [
      "en_US",
      "softwareTerms",
      "node",
      "typescript",
      "css",
      "html"
    ]
  },
  "knip": {
    "$schema": "https://knip.dev/schema.json",
    "entry": [
      "src/index.html",
      "src/shared/styles/index.css",
      "electron/preload/index.ts",
      "electron/preload/displayMediaPickerPreload.ts",
      "scripts/{dev,build-electron,check-repo-hygiene,check-version-consistency}.mjs",
      "scripts/{check-audit,check-declaration-consistency,check-electron-security}.d.mts"
    ],
    "project": [
      "src/**/*.{ts,tsx,css}",
      "electron/**/*.{ts,tsx}",
      "shared/**/*.ts",
      "scripts/**/*.{mjs,mts}"
    ],
    "ignoreDependencies": [
      "@doyensec/electronegativity"
    ]
  },
  "madge": {
    "tsConfig": "tsconfig.json",
    "fileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "ci",
          "revert"
        ]
      ]
    }
  }
}

{
  "compilerOptions": {
    // Path aliases (renderer + shared-core)
    "paths": {
      "@app/*": ["./src/app/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared-core/*": ["./shared/*"],
      "@electron/*": ["./electron/*"],
      "@ui/*": ["./src/shared/ui/*"],
      "@features/*": ["./src/features/*"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./config/tsconfig.app.json"
    },
    {
      "path": "./config/tsconfig.node.json"
    },
    {
      "path": "./config/tsconfig.node.test.json"
    }
  ]
}
